# Dependencies — installed inside the container. Los patrones sin barra solo
# casan con la raiz del contexto, asi que cada workspace lleva el suyo: sin
# ellos, un `docker build` desde un checkout con node_modules intenta pisar los
# que acaba de instalar la imagen.
node_modules
apps/*/node_modules
packages/*/node_modules
.pnpm-store

# Build outputs — built inside the container
dist
build
.turbo
*.tsbuildinfo

# Git
.git
.gitignore
.github

# Environment and secrets
.env
.env.*
*.keystore
*.jks
*.pem
*.key
*.p12
credentials.json
google-services.json

# IDE
.idea
.vscode
.claude
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test and coverage
coverage
apps/api/test

# Documentation
README.md
CLAUDE.md
progress.md
*.md

# Mobile app — not needed for API image
apps/mobile

# Shared package — only its sources are needed, its dist is built inside
packages/*/dist

# Tools
tools

# APK builds
*.apk

# Other root files not needed in the image
quedamos-prototype.jsx
lefthook.yml
turbo.json
bun.lock
.prettierrc.json
