<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/widget_papel">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_title"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/widget_tinta"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/config_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/config_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_config_empty"
        android:textSize="13sp"
        android:textColor="@color/widget_tinta_suave"
        android:visibility="gone" />

    <Button
        android:id="@+id/config_open_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/widget_config_open"
        android:textColor="@color/widget_tinta"
        android:visibility="gone" />

</LinearLayout>
