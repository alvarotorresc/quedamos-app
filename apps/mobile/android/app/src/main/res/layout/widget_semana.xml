<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_group_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_tinta"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_day_cell_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_day_ring_0"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/widget_day_letter_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tinta_suave"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day_cell_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_day_ring_1"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/widget_day_letter_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tinta_suave"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day_cell_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_day_ring_2"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/widget_day_letter_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tinta_suave"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day_cell_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_day_ring_3"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/widget_day_letter_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tinta_suave"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day_cell_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_day_ring_4"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/widget_day_letter_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tinta_suave"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day_cell_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_day_ring_5"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/widget_day_letter_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tinta_suave"
                android:textSize="10sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day_cell_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/widget_day_ring_6"
                android:layout_width="32dp"
                android:layout_height="32dp" />

            <TextView
                android:id="@+id/widget_day_letter_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_tinta_suave"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/widget_best_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/widget_tinta"
        android:textSize="13sp" />

</LinearLayout>
