<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31): allowBackup="false" ya excluye la copia en la nube, pero la
  transferencia dispositivo a dispositivo sigue activa si no se excluye aquí.
  La app no tiene nada que restaurar (sesión de Supabase, token del widget y
  preferencias se rehacen al entrar), así que se excluye todo en ambos canales.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
